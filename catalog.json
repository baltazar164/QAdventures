  "faq": [
    {
      "question": "Do you keep my passport or ID?",
      "answer": "No. We never hold your passport or any document."
    },
    {
      "question": "What documents do I need?",
      "answer": "A valid driver's license. An international driving permit is not required."
    },
    {
      "question": "Is there a deposit?",
      "answer": "No deposit."
    },
    {
      "question": "What is the minimum rental?",
      "answer": "One day."
    },
    {
      "question": "Is insurance included?",
      "answer": "Yes, third-party liability insurance is included."
    },
    {
      "question": "What about fuel?",
      "answer": "Please return the bike with a full tank."
    },
    {
      "question": "What if the bike breaks down?",
      "answer": "Call us. We come and fix it, or bring you another bike."
    },
    {
      "question": "Can I leave my luggage with you?",
      "answer": "Yes, you can leave it at the shop while you ride."
    },
    {
      "question": "Are helmets included?",
      "answer": "Yes, two helmets, and a top box on every bike."
    },
    {
      "question": "Do you deliver?",
      "answer": "Yes, to your hotel or the airport."
    },
    {
      "question": "Is there a distance limit?",
      "answer": "No. Ride anywhere in the Philippines."
    },
    {
